{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES6", // Define a versão do JavaScript gerado

    /* Modules */
    "module": "commonjs", // Usa CommonJS como sistema de módulos
    "rootDir": "./src", // Define a pasta raiz dos arquivos TypeScript
    "outDir": "./dist", // Define a pasta de saída para os arquivos JavaScript

    /* Interop */
    "esModuleInterop": true, // Permite a interoperabilidade entre CommonJS e ES Modules
    "forceConsistentCasingInFileNames": true, // Garante que o casing dos arquivos esteja correto

    /* Type Checking */
    "strict": true, // Habilita todas as verificações de tipo estritas
    "skipLibCheck": true, // Ignora a verificação de tipos em arquivos .d.ts

    /* Type Resolution */
    "types": [], // Não inclui automaticamente nenhum pacote de tipos
    "typeRoots": ["./node_modules/@types"], // Define onde procurar por tipos
    "lib": ["es6", "dom"] // Inclui apenas as bibliotecas necessárias
  },
  "include": ["src/**/*"], // Inclui todos os arquivos na pasta src
  "exclude": ["node_modules"] // Exclui a pasta node_modules
}